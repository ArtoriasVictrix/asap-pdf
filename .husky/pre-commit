# Always load a fresh Node.js version from nvm, regardless of the environment
# git was launched from (GUI clients and terminals with an old active Node
# version break lint-staged: Node 14 does not understand the '??=' syntax)
export NVM_DIR="$HOME/.nvm"
if [ -s "$NVM_DIR/nvm.sh" ]; then
	. "$NVM_DIR/nvm.sh" --no-use
	nvm use --silent "$(nvm version default)" >/dev/null 2>&1
fi

npx lint-staged
