{
	"name": "asap-pdf",
	"version": "1.0.0",
	"description": "HTML/PDF Framework based on Bootstrap. Perfect for developing beautiful PDFs using web technologies.",
	"main": "index.js",
	"homepage": "https://asap-pdf.com/",
	"repository": {
		"type": "git",
		"url": "https://github.com/ArtoriasVictrix/asap-pdf.git"
	},
	"keywords": [
		"css",
		"gulp",
		"html",
		"sass",
		"bootstrap",
		"pdf",
		"framework",
		"scss",
		"pug",
		"screenshot-testing",
		"pdf-document",
		"pdf-generation"
	],
	"bugs": {
		"url": "https://github.com/ArtoriasVictrix/asap-pdf/issues"
	},
	"engines": {
		"node": ">=22.22.2"
	},
	"scripts": {
		"prepare": "husky",
		"start": "cross-env NODE_ENV=production PDF=true gulp",
		"prod": "cross-env NODE_ENV=production gulp",
		"prod:mock": "cross-env NODE_ENV=production MOCK=true gulp",
		"prod:mock-pdf": "cross-env NODE_ENV=production MOCK=true PDF=true gulp",
		"dev": "cross-env NODE_ENV=development gulp",
		"dev:pdf": "cross-env NODE_ENV=development PDF=true gulp",
		"build": "cross-env NODE_ENV=production gulp build",
		"build:mock": "cross-env NODE_ENV=production MOCK=true gulp build",
		"build-dev": "cross-env NODE_ENV=development gulp build:dev",
		"pdf": "gulp html2pdf",
		"mock": "gulp mock",
		"mock-pdf": "gulp --series mock html2pdf",
		"sc:init": "gulp screenshotsInit",
		"sc:compare": "gulp screenshotsCompare",
		"sc:refresh": "gulp screenshotsRefresh",
		"pdf2img:init": "gulp pdf2imgInit",
		"pdf2img:compare": "gulp pdf2imgCompare",
		"pdf2img:refresh": "gulp pdf2imgRefresh",
		"scss:lint": "stylelint 'app/scss/**/*.scss'",
		"scss:fix": "stylelint 'app/scss/**/*.scss' --fix",
		"js:lint": "eslint gulpfile.js webpack.config.js gulp .storybook",
		"test:init": "gulp --series screenshotsInit pdf2imgInit",
		"test": "cross-env NODE_ENV=production gulp --series screenshotsCompare pdf2imgCompare",
		"test:refresh": "gulp --series pdf2imgRefresh screenshotsRefresh",
		"clean": "gulp clean",
		"storybook": "cross-env STORYBOOK=true NODE_ENV=production gulp --series scss fonts && storybook dev -p 6006",
		"build-storybook": "cross-env STORYBOOK=true NODE_ENV=production gulp --series scss fonts && storybook build"
	},
	"author": "Nikolay Zhidkov",
	"license": "MIT",
	"devDependencies": {
		"@babel/core": "7.29.13",
		"@babel/preset-env": "7.29.14",
		"@storybook/addon-essentials": "8.6.14",
		"@storybook/addon-links": "8.6.14",
		"@storybook/html": "8.6.14",
		"@storybook/html-webpack5": "8.6.14",
		"@storybook/theming": "8.6.14",
		"babel-loader": "10.1.1",
		"browser-sync": "3.0.4",
		"cheerio": "1.2.0",
		"cross-env": "10.1.0",
		"eslint": "10.15.0",
		"fs-extra": "11.4.1",
		"glob": "14.0.6",
		"globals": "17.14.0",
		"gulp": "5.0.1",
		"gulp-autoprefixer": "10.0.0",
		"gulp-babel": "8.1.0",
		"gulp-beautify": "3.0.0",
		"gulp-cached": "1.1.1",
		"gulp-cheerio": "1.0.0",
		"gulp-clean-css": "4.3.0",
		"gulp-concat": "2.6.1",
		"gulp-if": "3.0.0",
		"gulp-notify": "5.0.0",
		"gulp-plumber": "1.2.1",
		"gulp-pug": "5.0.0",
		"gulp-rename": "2.1.0",
		"gulp-sass": "6.0.1",
		"gulp-sourcemaps": "3.0.0",
		"gulp-tap": "2.0.0",
		"gulp-terser": "2.1.0",
		"husky": "9.1.7",
		"inline-source": "8.0.3",
		"join-images": "1.3.1",
		"lint-staged": "17.6.0",
		"open": "11.0.4",
		"pdftoimage": "1.0.0",
		"pixelmatch": "5.3.0",
		"pngjs": "7.0.0",
		"postcss-scss": "4.0.9",
		"prettier": "3.10.1",
		"pug-lint": "2.7.0",
		"puppeteer": "25.17.0",
		"purgecss": "9.1.0",
		"sass": "1.108.2",
		"sharp": "0.35.5",
		"storybook": "8.6.14",
		"stylelint": "18.0.0",
		"stylelint-order": "8.1.3",
		"stylelint-scss": "7.5.0",
		"through2": "5.0.12"
	},
	"overrides": {
		"gulp-cheerio": {
			"cheerio": "1.2.0"
		}
	},
	"browserslist": [
		"last 2 versions"
	],
	"lint-staged": {
		"./app/scss/**/*.scss": [
			"stylelint --fix"
		],
		"./app/pug/**/*.pug": [
			"pug-lint"
		]
	}
}
